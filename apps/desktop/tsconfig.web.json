{
  "extends": "../../tsconfig.base.json",
  "include": ["src/renderer/src/**/*", "src/preload/*.d.ts"],
  "compilerOptions": {
    "composite": false,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "baseUrl": ".",
    "paths": { "@/*": ["src/renderer/src/*"] },
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "types": []
  }
}
