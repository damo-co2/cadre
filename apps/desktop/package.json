{
  "name": "@grokbot/desktop",
  "version": "0.2.3",
  "private": true,
  "description": "Cadre desktop app",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "dist": "electron-vite build && node ../../scripts/bundle-server.mjs && electron-builder --mac --config electron-builder.yml",
    "dist:dir": "electron-vite build && node ../../scripts/bundle-server.mjs && electron-builder --mac --dir --config electron-builder.yml",
    "dist:mac": "electron-vite build && node ../../scripts/bundle-server.mjs && electron-builder --mac --config electron-builder.yml",
    "dist:linux": "electron-vite build && node ../../scripts/bundle-server.mjs && electron-builder --linux --config electron-builder.yml",
    "dist:win": "electron-vite build && node ../../scripts/bundle-server.mjs && electron-builder --win --config electron-builder.yml"
  },
  "dependencies": {
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@grokbot/shared": "*",
    "lucide-react": "^0.546.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^4.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "author": "Damien Koh",
  "productName": "Cadre",
  "homepage": "https://github.com/damo-co2/cadre"
}
